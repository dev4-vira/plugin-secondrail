# Copied to .env (mode 0600, git-ignored) by bin/setup, which fills the passwords with random values.
# Host port for WordPress, published on 127.0.0.1 only.
WP_PORT=8190
# Database passwords (random, created by bin/setup).
DB_PASSWORD=
DB_ROOT_PASSWORD=
# WordPress administrator password (user "admin"), random, created by bin/setup.
WP_ADMIN_PASSWORD=
# Real-sandbox run only, written by bin/sandbox connect and removed by bin/sandbox clean.
# SECONDRAIL_API_BASE=
# SECONDRAIL_TEST_SECRET_KEY=
